{
  "expo": {
    "name": "مصحف الشمرلي",
    "slug": "mushaf-shamarly",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "mushaf-shamarly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#ffffff"
    },
    "androidNavigationBar": {
      "visible": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mushaf.shamarly",
      "versionCode": 4,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "backgroundColor": "#E6F4FE"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "elarbims",
    "ios": {
      "bundleIdentifier": "com.mushaf.shamarly"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a34d1973-cb17-46f5-b256-fbdee47925b7"
      }
    }
  }
}
